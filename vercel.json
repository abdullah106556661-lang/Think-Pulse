{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/site/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app/(.*)",
      "destination": "/api"
    },
    {
      "source": "/deployed/(.*)",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/((?!api|site|app|deployed|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
