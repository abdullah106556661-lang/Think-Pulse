rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'abdullah106556661@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidId(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Generated projects collection
    match /projects/{projectId} {
      allow get: if true; // Public access for deployed web apps
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(projectId) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidId(projectId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && isValidId(projectId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Multimodal generations history
    match /generations/{generationId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(generationId) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidId(generationId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && isValidId(generationId) && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
